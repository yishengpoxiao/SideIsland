* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.desktop text eol=lf
*.ico binary
*.png binary
# Diagnostic fixtures are deliberately hash-pinned to their original bytes.
tools/native-diagnostics/fixtures/layout-loop/** -text
# Preserve upstream license bytes, including their original whitespace.
cross-platform/licenses/*.txt -text
THIRD-PARTY-NOTICES.txt -text
